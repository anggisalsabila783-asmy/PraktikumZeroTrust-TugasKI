# ===== Salin file ini menjadi .env =====
# Windows : copy .env.example .env
# Mac/Linux: cp .env.example .env

# Port
GATEWAY_PORT=3000
NILAI_PORT=3001
TRANSKRIP_PORT=3002

# Secret (GANTI untuk penggunaan nyata; untuk demo boleh dibiarkan)
JWT_SECRET=ganti-dengan-secret-jwt-yang-panjang-dan-acak-123456
GATEWAY_SECRET=ganti-dengan-gateway-secret-rahasia-abcdef

# Kredensial Service Nilai untuk POST /auth/service
SERVICE_CLIENT_ID=service-nilai
SERVICE_CLIENT_SECRET=ganti-dengan-client-secret-service-nilai

# Masa berlaku access token (default tugas: 10 menit)
ACCESS_TOKEN_TTL=10m

# ===== JAM AKSES (untuk PUT /nilai/:id dan POST /kelas/:id/finalisasi) =====
# Format HH:MM. Awal inklusif, akhir eksklusif. Boleh "24:00".
# Contoh demo "di luar jam": ACCESS_START=00:00 dan ACCESS_END=00:00 (selalu ditolak)
# Contoh demo "selalu boleh": ACCESS_START=00:00 dan ACCESS_END=24:00
ACCESS_START=07:00
ACCESS_END=21:00
ACCESS_TIMEZONE=Asia/Jakarta

# Lokasi file database SQLite
DB_PATH=./data/sistem_nilai.db
